{
  "schemaVersion": 1,
  "id": "titlebarchanger",
  "version": "${version}",
  "name": "TitlebarChanger",
  "description": "TitlebarChanger is a client-side mod that lets you personalize the Minecraft window. It allows customization of titlebar text, colors, and border appearance.\n\n⚡ Windows 11: full support (custom colors, rounded corners, border styling).\n⚡ Windows 10: limited support — only Light/Dark theme switching.",
  "authors": [
    "Talor1n"
  ],
  "license": "GPL-3.0",
  "icon": "logo.png",
  "environment": "*",
  "contact": {
    "issues": "https://github.com/Talor1n/TitlebarChanger/issues",
    "sources": "https://github.com/Talor1n/TitlebarChanger"
  },
  "entrypoints": {
    "client": [
      "net.talor1n.titlebarchanger.fabric.TitlebarChangerFabric"
    ],
    "modmenu": [
      "net.talor1n.titlebarchanger.fabric.ClothConfigModMenuIntegration"
    ]
  },
  "mixins": [
    "titlebarchanger.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.10",
    "minecraft": ">=1.20 <=1.20.1",
    "java": ">=17"
  },
  "recommends": {
    "cloth-config2": ">=11.1.136",
    "modmenu": ">=7.0.1"
  }
}
